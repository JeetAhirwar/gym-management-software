# ---------------------------------------------------------------------------
# Pulse Gym Suite — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Supabase project credentials (Project Settings -> API).
# Only the PUBLIC anon key belongs in the browser. Never put the service-role
# key (or any secret JWT) in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Demo mode: shows a fully working offline sample dataset with a permanent
# "DEMO MODE" badge. Requires VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY to be
# empty or unset. Never enable in production.
VITE_DEMO_MODE=false

# Single business timezone used for membership validity, reports and
# "today" calculations (IANA name).
VITE_GYM_TIMEZONE=Asia/Kolkata

# Optional branding shown on login / membership cards / receipts.
VITE_GYM_NAME=Pulse Fitness Studio
